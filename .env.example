# Atlas 300I Duo 服务器示例：device 0/1 已被其他业务占用时使用物理 device 2。
# 单卡映射进容器后，可用设备会从 0 重新编号，因此应用逻辑 Device ID 使用 0。
ASCEND_PHYSICAL_DEVICE_ID=2
ASCEND_LOGICAL_DEVICE_ID=0
SAM3_PORT=18000

# 多实例透明负载均衡（docker-compose.dual.yml）。Atlas 300I Duo 的同一张
# 物理卡包含两个逻辑设备；本项目场景下对应宿主机 device 2 和 device 3。
SAM3_DEVICE_A=2
SAM3_DEVICE_B=3
# 每颗逻辑 NPU 容器内运行的 Uvicorn/SAM3 worker 进程数。
# 不会创建多个共享同一 Device 的容器。先从 1 开始，确认收益后再改为 2。
SAM3_DEVICE_A_INSTANCES=1
SAM3_DEVICE_B_INSTANCES=1
# SAM3 单 worker 首次加载 OM 模型约需 30 秒。多 worker 模式必须放宽
# Uvicorn 默认 5 秒的 worker 健康检查超时，避免初始化尚未完成就被回收。
SAM3_WORKER_HEALTHCHECK_TIMEOUT=180
# Host 网络模式下的本机回环端口，只供 Nginx 访问；必须互不相同，并避免与
# 宿主机已有服务冲突。它们不会监听外部网卡。
SAM3_BACKEND_A_PORT=18001
SAM3_BACKEND_B_PORT=18002
SAM3_PUBLIC_PORT=18000
SAM3_GATEWAY_IMAGE=nginx:1.30.4-alpine

# obj-refine 每请求裁剪/参与聚合的预检测框上限；也作为 API 默认值。
# 请求可以调低，不能超过容器配置的上限。调整后需重建容器，无需重新编译模型。
SAM3_REFINE_MAX_CROPS=4
SAM3_REFINE_MAX_PRE_DETECTIONS=64

CANN_IMAGE=swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:9.0.0-310p-ubuntu22.04-py3.11

# Vision OM 路径（容器内）。升级 TRT 对齐预处理时，先只重转 Vision 模型：
# ONLY_MODEL=vision-encoder VISION_OUTPUT_NAME=vision-encoder-trt bash scripts/convert_models.sh
# 然后将下一行改为 models/om-models/vision-encoder-trt.om，并重建服务容器。
VISION_MODEL=models/om-models/vision-encoder.om

# 离线 Vision 基准/AOE 工具配置；不会改变服务启动方式，也不会自动替换 VISION_MODEL。
SAM3_BENCH_IMAGE=ascend-sam3-service:latest
VISION_TUNED_OUTPUT_NAME=vision-encoder-trt-tuned
# SOC_VERSION 在 AOE 流程中用于校验实际设备；在线调优使用容器逻辑 --device=0。
SOC_VERSION=Ascend310P3

# 国内网络无法访问 GitHub 时可替换为内部镜像地址。
# TOKENIZERS_GIT_REPOSITORY=https://github.com/mlc-ai/tokenizers-cpp.git
# ABSEIL_GIT_REPOSITORY=https://github.com/abseil/abseil-cpp.git
