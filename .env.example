# Atlas 300I Duo 服务器示例：device 0/1 已被其他业务占用时使用物理 device 2。
# 单卡映射进容器后，可用设备会从 0 重新编号，因此应用逻辑 Device ID 使用 0。
ASCEND_PHYSICAL_DEVICE_ID=2
ASCEND_LOGICAL_DEVICE_ID=0
SAM3_PORT=18000

# 双实例透明负载均衡（docker-compose.dual.yml）。Atlas 300I Duo 的同一张
# 物理卡包含两个逻辑设备；本项目场景下对应宿主机 device 2 和 device 3。
SAM3_DEVICE_A=2
SAM3_DEVICE_B=3
SAM3_PUBLIC_PORT=18000
SAM3_GATEWAY_IMAGE=nginx:1.30.4-alpine

CANN_IMAGE=swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:9.0.0-310p-ubuntu22.04-py3.11

# 国内网络无法访问 GitHub 时可替换为内部镜像地址。
# TOKENIZERS_GIT_REPOSITORY=https://github.com/mlc-ai/tokenizers-cpp.git
# ABSEIL_GIT_REPOSITORY=https://github.com/abseil/abseil-cpp.git
