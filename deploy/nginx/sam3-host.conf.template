# Host 网络部署不依赖 Docker 用户自定义 bridge/DNS。两个 SAM3 后端仅在
# 127.0.0.1 上监听，Nginx 是唯一监听外部地址的进程。
log_format sam3 '$remote_addr - $request_id [$time_local] "$request" '
                 'status=$status request_time=$request_time '
                 'upstream=$upstream_addr upstream_status=$upstream_status '
                 'upstream_time=$upstream_response_time';

upstream sam3_backend {
    zone sam3_backend 64k;
    least_conn;

    server 127.0.0.1:${SAM3_BACKEND_A_PORT} max_fails=2 fail_timeout=10s;
    server 127.0.0.1:${SAM3_BACKEND_B_PORT} max_fails=2 fail_timeout=10s;

    keepalive 16;
}

server {
    listen ${SAM3_PUBLIC_PORT};
    server_name _;

    access_log /var/log/nginx/access.log sam3;
    error_log /var/log/nginx/error.log warn;

    client_max_body_size 50m;
    client_body_timeout 30s;
    send_timeout 120s;

    location = /gateway-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://sam3_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_connect_timeout 5s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        proxy_request_buffering on;
        proxy_next_upstream error timeout http_502 http_503 http_504 non_idempotent;
        proxy_next_upstream_tries 2;

        add_header X-SAM3-Upstream $upstream_addr always;
    }
}
